# ----------------------------------------------------------------------------
# alphaXiv Scroll configuration. Copy to .env.local and fill in as needed.
# Every value is optional: with nothing set, the app reads alphaXiv's public
# feed API (Hot, then Most liked) and needs no key.
# ----------------------------------------------------------------------------

# Lists to read, in priority order, as Sort:Interval pairs.
#   Sorts:     Hot, Likes, Views, Comments, GitHub, Recent
#   Intervals: 3 Days, 7 Days, 30 Days, 90 Days, All time
FEED_LISTS=Hot:30 Days,Likes:All time

# Papers per feed request (5-100) and pages read per list (1-20).
# Explainers are rare, so the app scans several pages of each list.
FEED_PAGE_SIZE=100
FEED_MAX_PAGES=4

# Where the data comes from: auto | feed-api | mcp
#   auto = the public feed API, falling back to MCP when ALPHAXIV_API_KEY is set
FEED_SOURCE=auto

# Base URL of alphaXiv's public feed API.
ALPHAXIV_API_URL=https://api.alphaxiv.org

# Optional alphaXiv MCP API key (alphaXiv > Settings > MCP/API), used only for
# the MCP fallback. Server-side only: never prefix this with NEXT_PUBLIC_.
ALPHAXIV_API_KEY=

# MCP endpoint (streamable HTTP) and how many Hot papers the MCP route scans.
ALPHAXIV_MCP_URL=https://api.alphaxiv.org/mcp/v1
HOT_FEED_LIMIT=60

# Base URL for alphaXiv paper pages (/abs/<id>), read only by the MCP fallback.
ALPHAXIV_BASE_URL=https://www.alphaxiv.org

# Seconds to cache alphaXiv responses on the server.
CACHE_TTL_SECONDS=1800
