# ----------------------------------------------------------------------------
# alphaXiv Scroll configuration. Copy to .env.local and fill in as needed.
# Every value is optional: with nothing set, the app reads the public Hot page.
# ----------------------------------------------------------------------------

# alphaXiv MCP API key (alphaXiv > Settings > MCP/API). When set, the trending
# list comes from the MCP `get_hot_feed` tool instead of the public Hot page.
# Server-side only: never prefix this with NEXT_PUBLIC_.
ALPHAXIV_API_KEY=

# MCP endpoint (streamable HTTP). Only change this if alphaXiv moves it.
ALPHAXIV_MCP_URL=https://api.alphaxiv.org/mcp/v1

# Base URL for alphaXiv web pages (Hot page and /abs/<id> paper pages).
ALPHAXIV_BASE_URL=https://www.alphaxiv.org

# Where the trending list comes from: auto | mcp | hot-page
#   auto     = MCP when ALPHAXIV_API_KEY is set, falling back to the Hot page
FEED_SOURCE=auto

# How many Hot papers to scan for video explainers (1-200, MCP limit).
HOT_FEED_LIMIT=60

# Seconds to cache alphaXiv responses on the server.
CACHE_TTL_SECONDS=600
